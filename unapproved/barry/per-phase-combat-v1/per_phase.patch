index 1902fe4..602e2ab 100644
--- a/sim/velocity_shift/equations.py
+++ b/sim/velocity_shift/equations.py
@@ -1011,3 +1011,17 @@ MS_TARGETS = {
     "G2b_weak_improving_attempts": 60.0, "G3a_drop_kid1_boss": 30.0, "G3b_boss_read_gap": 10.0, "G3c_min_step": 3.0,
     "G4a_min_strong_floor": 40.0, "G4b_boss_weak_floor_max": 10.0, "G5_boss_strong_max_build": 95.0,
 }
+
+
+# PROTOTYPE (unapproved/barry/per-phase-combat-v1): districts that resolve combat per phase (Austin 2026-11-20 canon).
+PER_PHASE_DISTRICTS = ("street", "wangan")
+PLAYER_PRESS_SEED_OFFSET = 15_485_863
+
+
+def sample_press_score(rng, sigma_over_a0: float, width_over_w0: float) -> float:
+    """One timing press: s = max(0, 1 - |e| / a), e ~ N(0, sigma) (a0 units); E[s] = expected_hit_quality."""
+    if width_over_w0 <= 0.0:
+        return 0.0
+    if sigma_over_a0 <= 0.0:
+        return 1.0
+    return round_qte_score(max(0.0, 1.0 - abs(rng.gauss(0.0, sigma_over_a0)) / width_over_w0))
